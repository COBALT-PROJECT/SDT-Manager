# SDT Manager Environment Configuration

# SDT Interface Configuration
SDT_INTERFACE_HOST=localhost
SDT_INTERFACE_PORT=30008

# API Server Configuration  
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8008

# Kubernetes Configuration
KUBECONFIG=/home/sdt/.kube/config

# Logging Configuration
LOG_LEVEL=INFO

# Application Configuration
PYTHONPATH=/app

# Authentication Manager Configuration
AM_BASE_URL=http://iam.cobalt.local:3100
WALLET_CONTROLLER_URL=http://iam.cobalt.local:3200
WALLET_CONTROLLER_KEY=atestkeytoremotelycontrolthewallet
DIGITAL_TWIN_API_KEY=IvPBXYOesvseJQ3u0mwLPFgvN3Ugy2-P35aW2WlSUvQ

# Credential Store Configuration
CREDENTIAL_DB_PATH=sdt_timestamps_credentials.db

# Component Auth Endpoint Ports (each component exposes POST /auth/token)
SDT_AUTH_PORT=8000
IDS_SDT_AUTH_PORT=8004

# MQTT Failure Reporting
MQTT_FAILURE_REPORTING_ENABLED=true
MQTT_FAILURE_HOST=10.163.1.161
MQTT_FAILURE_PORT=1883
MQTT_COMPONENT_ID=sdt-manager-timestamps-01
MQTT_FAILURE_QUEUE_SIZE=1000
MQTT_FAILURE_MAX_RETRIES=3
MQTT_FAILURE_RETRY_DELAY=2
WATCHTOWER_AUTH_PORT=8080

# DLT/CCMLedger workflow disabled; former configuration retained as comments
# CCMLEDGER_HOST=cobalt-dlt.cobalt.local
# CCMLEDGER_PORT=3000
# CCMLEDGER_SBOM_PATH=/v1/manufacturer/SBOM
# CCMLEDGER_ENABLED=true

# Optional: Custom paths for YAML files
# YAML_PATH=/home/ubuntu/k3s-SDT-Ditto/yaml_scripts/
# IDS_YAML_BASE_PATH=/home/ubuntu/true-connector/kubernetes/

# Usecase-specific IDS sync manifest (quantum_sdt branch: quantum provider)
IDS_SYNC_MANIFEST=pods_sync_k3s_quantum.yml
# Timestamp storage (the Kubernetes ConfigMap overrides these paths).
PERFORMANCE_LOG_PATH=performance_events.jsonl
PERFORMANCE_MAX_RECORDS=10000
