{
  "config_name": "Quantum usecase",
  "config_version": "3.0",

  "evidence_collectors": [
    {
      "collector_id": "clouditor",
      "enabled": true,
      "categories": ["QDT"],

      "mqtt": {
        "topics": ["ditto-cobalt/*"]
      },

      "endpoint": "http://${CLOUDITOR_IP}:${CLOUDITOR_PORT}/v1/assessment/evidences",
      "auth": {
        "type": "oauth2",
        "token_url": "http://${CLOUDITOR_IP}:${CLOUDITOR_AUTH_PORT}/v1/auth/token",
        "client_id": "clouditor",
        "client_secret_env": "CLOUDITOR_SECRET"
      },

      "evidence": {
        "type": "files",
        "files": ["qpu_data.json"]
      },

      "transform": "qpu_data"
    }
  ],

  "defaults": {
    "retry_attempts": 3,
    "max_file_size_mb": 50,
    "timeout_seconds": 45
  }
}
